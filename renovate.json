{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile"],
  "packageRules": [
    {
      "description": "The PETL base image: keep the pinned digest current for the tag this project follows, and merge once the PR's checks pass",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["partnersinhealth/petl"],
      "pinDigests": true,
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
